# Contact form delivery (Resend — https://resend.com).
# Without these the form is refused in production and logged in development.
RESEND_API_KEY=
CONTACT_TO=contact@asm-architectes.ma
CONTACT_FROM=ASM <site@asm-architectes.ma>

# Production origin, used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.asm-architectes.ma

# Backoffice (/admin) — lets the client edit projects and studio info without
# a redeploy. See "The backoffice" in the README before deploying.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
DATABASE_PATH=./data/asm.db
